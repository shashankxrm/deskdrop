# Copy to deploy/prod/.env on the VM. Never commit .env.
# Generate secrets on the box; do not reuse the local Compose pepper.

DESKDROP_HOST=yourname.duckdns.org
CADDY_EMAIL=you@example.com

POSTGRES_PASSWORD=
DEVICE_TOKEN_PEPPER=

# /metrics basic auth. Caddy uses METRICS_HASH; k3s Traefik uses METRICS_PASSWORD.
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
METRICS_USER=scrape
METRICS_HASH=
METRICS_PASSWORD=

# Optional: docker compose --profile metrics up -d
GRAFANA_CLOUD_RW_URL=
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_TOKEN=

# D6: OCI Object Storage S3-compat (Customer secret keys, not the API PEM)
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
OCI_S3_NAMESPACE=
OCI_S3_REGION=us-phoenix-1
OCI_S3_BUCKET=deskdrop-backups
