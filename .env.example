# Copy to .env and fill in. Never commit .env.
# Required variables must be non-empty. The API (B1) refuses to start if they are missing.
# Do not put real secrets, tokens, or fallback defaults in this file.

# HMAC key for hashing device tokens at rest (random, long).
DEVICE_TOKEN_PEPPER=

# Postgres connection string used by the API.
# Local Compose (A2) injects its own URL into the api service; you do not need .env for docker compose up.
DATABASE_URL=

# Listen address, e.g. :8080
HTTP_ADDR=

# Dashboard origin for CORS allowlist (scheme + host + port, no path).
DASHBOARD_ORIGIN=

# Production (D0) only. Local Compose leaves these unset/false.
# COOKIE_SECURE=true
# TRUST_PROXY=true
